<!--
  Code stripping is enabled for Android to keep the APK small. Photon Fusion and the game's own code use
  reflection (weaved network behaviours, Unity message methods, UnitySendMessage callbacks from Java), so they
  are preserved in full; only unused parts of the .NET and Unity engine libraries get stripped.
-->
<linker>
  <assembly fullname="Assembly-CSharp" preserve="all" />
  <assembly fullname="Fusion.Common" preserve="all" />
  <assembly fullname="Fusion.Log" preserve="all" />
  <assembly fullname="Fusion.Realtime" preserve="all" />
  <assembly fullname="Fusion.Runtime" preserve="all" />
  <assembly fullname="Fusion.Sockets" preserve="all" />
  <assembly fullname="Fusion.Unity" preserve="all" />
  <assembly fullname="Photon.Realtime" preserve="all" />
  <assembly fullname="PhotonClient" preserve="all" />
  <assembly fullname="PhotonWebSocket" preserve="all" />
  <assembly fullname="NanoSockets" preserve="all" />
  <assembly fullname="websocket-sharp" preserve="all" />
  <assembly fullname="Unity.TextMeshPro" preserve="all" />
  <assembly fullname="UnityEngine.UI" preserve="all" />
  <assembly fullname="Unity.InputSystem" preserve="all" />
</linker>
